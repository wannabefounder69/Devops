const { Builder, By } = require('selenium-webdriver');

async function registrationTest() {

    let driver = await new Builder()
        .forBrowser('chrome')
        .build();

    try {

        await driver.get(
            'file:///C:/RegistrationTesting/register.html'
        );

        // Enter name
        await driver.findElement(By.id('name'))
            .sendKeys('Karan');

        // Enter email
        await driver.findElement(By.id('email'))
            .sendKeys('karan@gmail.com');

        // Enter password
        await driver.findElement(By.id('password'))
            .sendKeys('123456');

        // Click register
        await driver.findElement(By.id('submit'))
            .click();

        // Verify result
        let result = await driver.findElement(
            By.id('message')
        ).getText();

        console.log(result);

    } finally {
        await driver.quit();
    }
}

